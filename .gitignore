backend/.venv/
__pycache__/
*.pyc
*.egg-info/
.env
.env.local
.env.production
backend/data/out/*
!backend/data/out/.gitkeep
frontend/node_modules/
frontend/dist/
.DS_Store
.pytest_cache/
.firebase/

# Replay recordings are demo infrastructure, not generated output: the recorded golden
# run is what makes the demo survive a Vertex quota refusal, so it must be committed.
!backend/data/out/replay/
!backend/data/out/replay/*.json

# The seven-case harness's result summary is evidence the gate was actually run, not
# just generated output to regenerate on demand -- keep the latest run committed.
!backend/data/out/run_cases.json

# The lot traveler is one of the two files a judge UPLOADS into the running prototype
# (the other being a defect photo from backend/data/images/, which is committed). It is
# generated by data/generate_plant.py like the CSVs beside it, but unlike them it is a
# demo input, not an intermediate: without it in the repo, anyone cloning this has no
# spreadsheet to try the messy-Excel path with unless they first run the generator.
# 6 KB, so there is no cost to carrying it.
!backend/data/out/*.xlsx

# frontend/.env.production carries no secret -- just the public Cloud Run API origin
# and VITE_USE_MOCKS=false -- and it's the only thing that makes `npm run build`
# reproduce the actual deployed bundle. Committing it is what makes a from-scratch
# rebuild tonight (or by anyone else) produce the same bundle that's live, instead of
# silently building against frontend/.env's dev defaults (VITE_USE_MOCKS=true).
!frontend/.env.production

# Firebase CLI debug output, written beside firebase.json on every deploy.
firebase-debug.log
*firebase-debug.log
